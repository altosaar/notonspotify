---
import "../styles/global.css";
import playlist from "../generated/playlist.json";
import type { ResolvedTrack } from "../lib/adapters/types.ts";
// Rendered at build time, not shipped to the browser: attribution is static
// text and has no business in the player bundle.
import mirrors from "../lib/faces/clocksdev/manifest.json";

/** One entry per person, so each author is named once and reads as a person
 *  rather than as a row in a table of forty. */
const byAuthor = [
  ...mirrors
    .reduce((map, clock) => {
      const author = clock.author?.trim() || "Anonymous";
      const entry = map.get(author) ?? { author, website: clock.website || "", clocks: [] };
      entry.clocks.push(clock.name);
      if (!entry.website && clock.website) entry.website = clock.website;
      map.set(author, entry);
      return map;
    }, new Map<string, { author: string; website: string; clocks: string[] }>())
    .values(),
].sort((a, b) => a.author.localeCompare(b.author));

const tracks = playlist as ResolvedTrack[];
const description =
  "A clock that tells track time — a player for music that isn't on Spotify, from YouTube, SoundCloud and Bandcamp.";
const canonical = new URL("/", Astro.site).href;
const og = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>not on spotify</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="not on spotify" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* The two faces jaan.io already serves, and nothing else. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/HankenGrotesk-latin.woff2"
      crossorigin
    />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Inter.woff2" crossorigin />
  </head>

  <body>
    <div class="app">
      <header class="bar">
        <button class="ask" id="ask" type="button" aria-label="about">?</button>
      </header>

      {
        /* A real <dialog>: it takes focus, traps it, closes on Escape and comes
           with its own backdrop — all of which would otherwise be hand-written
           and worse. */
      }
      <dialog class="about" id="about" aria-label="about" tabindex="-1">
        <button class="close" id="about-close" type="button" aria-label="close">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5 19 19M19 5 5 19"></path>
          </svg>
        </button>
        <ul class="credits">
          <li>clocks: <a href="https://clocks.dev/">https://clocks.dev/</a></li>
          <li>code: claude</li>
          <li>thought: <a href="https://jaan.io">https://jaan.io</a></li>
          <li>
            submit a song:{" "}
            <a href="mailto:j@jaan.io?subject=Not%20on%20Spotify%3A%20%7Binsert%20song%20here%7D"
              >j@jaan.io</a
            >
          </li>
        </ul>

        {
          /* Attribution for the mirrored faces. Every one of the forty is a
             copy of someone's work, so every one of them is named here, under
             the person who made it. */
        }
        <section class="attrib">
          <h2>clock faces</h2>
          <p>
            All {mirrors.length} of them are mirrored, unmodified, from
            <a href="https://clocks.dev/">clocks.dev</a> — the whole of it — and were made by the {
              byAuthor.length
            } people below. One per track, a different set each time the site is built.
          </p>
          <p class="notice">
            <a href="https://clocks.dev/create">clocks.dev</a> releases every published clock into the
            public domain — “anyone may use, modify, and share it”. Nobody here is owed a credit, then.
            They are named anyway, because someone drew each of these and a public domain dedication gives
            away the copyright, not the authorship.
          </p>
          <ul class="authors">
            {
              byAuthor.map((entry) => (
                <li>
                  <span class="who">
                    {entry.website ? <a href={entry.website}>{entry.author}</a> : entry.author}
                  </span>
                  <span class="what">{entry.clocks.join(", ")}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </dialog>

      <main>
        {/* The clock face is built by clock.ts; this is the box it lands in. */}
        <div class="clock" id="clock"></div>

        {
          /* Title, then artist under it, then the badge — four lines that each
             hold their own height whether or not they have anything in them, so
             moving between tracks never shifts the clock above or the dock
             below. All four are filled in by the player. */
        }
        <div class="meta">
          <p class="track" id="meta"></p>
          <p class="artist" id="artist"></p>
          {
            /* The dot is decoration; the words carry the meaning, so the dot is
               aria-hidden and the line reads as plain text. `hidden` rather
               than emptied, so a track that isn't flagged has no stray blank
               line in the accessibility tree — the room stays reserved in CSS
               either way. */
          }
          <p class="banger" id="banger" hidden>
            <span class="banger-dot" aria-hidden="true"></span>Certified banger
          </p>
          <p class="status" id="status" role="status" aria-live="polite"></p>
        </div>

        {
          /* Shuffle, back, play, forward, repeat. All drawn, all square-cornered
             — no rounded joins, no rounded buttons; the play disc is the one
             curve on the row and it is a disc, not a corner. */
        }
        <div class="controls">
          <button class="chip" id="shuffle" type="button" aria-label="shuffle: off">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 6h4l10 12h4"></path>
              <path d="M3 18h4l10-12h4"></path>
              <path d="m18 3 3 3-3 3"></path>
              <path d="m18 15 3 3-3 3"></path>
            </svg>
          </button>

          <button class="chip" id="prev" type="button" aria-label="previous">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="solid" d="M20 5 9 12l11 7z"></path>
              <path class="solid" d="M5 5h2.5v14H5z"></path>
            </svg>
          </button>

          {
            /* A filled disc with the mark knocked out of it, so the triangle is
               the page's black rather than a second colour to keep in step. */
          }
          <button class="play" id="toggle" type="button" aria-label="play">
            <svg viewBox="0 0 44 44" aria-hidden="true">
              <circle class="disc" cx="22" cy="22" r="21"></circle>
              <path class="mark" id="glyph" d="M17 13 32 22 17 31z"></path>
            </svg>
          </button>

          <button class="chip" id="next" type="button" aria-label="next">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="solid" d="M4 5l11 7-11 7z"></path>
              <path class="solid" d="M16.5 5H19v14h-2.5z"></path>
            </svg>
          </button>

          <button class="chip" id="repeat" type="button" aria-label="repeat: off">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 11V5h13"></path>
              <path d="m14 2 3 3-3 3"></path>
              <path d="M20 13v6H7"></path>
              <path d="m10 16-3 3 3 3"></path>
              <text class="one" x="12" y="15.5">1</text>
            </svg>
          </button>

          {
            /* The way out: for a track with a `link:` in tracks.yaml, the place
               to actually buy the record. Empty and hidden until the player
               says otherwise — which track is showing is decided in the browser
               (the opening one is random), so it can't be rendered here. The
               room for it is reserved either way, so tracks with a link and
               tracks without don't move the page between them. */
          }
          <a class="out" id="out" href="#" rel="noopener" target="_blank" hidden>
            <svg class="out-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14 4h6v6"></path>
              <path d="M20 4 11 13"></path>
              <path d="M17 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h5"></path>
            </svg>
          </a>
        </div>
      </main>

      {/* The dock band: one fixed height, whatever is playing (spec §4.3). */}
      <div class="dock" id="dock"></div>
    </div>

    {
      /* Inlined rather than fetched: the list is small, and this keeps it out of
        the JS bundle and off the critical path. */
    }
    <script id="playlist" type="application/json" is:inline set:html={JSON.stringify(tracks)} />
    <script>
      import "../lib/player.ts";
    </script>
  </body>
</html>
