---
/**
 * The face picker. Dev server only — `npm run dev`, then /faces/1.
 *
 * Ten clocks a page, running, so the two decisions can be made by looking: does
 * this belong here, and is it too still to read at track speed. Ticking a box
 * writes faces.json (see the facesWriter plugin in astro.config.mjs), so there
 * is nothing to copy, paste or remember to save.
 *
 * Every clock carries its number in that file too, because a text editor is
 * always a working fallback.
 *
 * `getStaticPaths` returns nothing in a production build, so this never ships.
 */
import { readFileSync } from "node:fs";
import manifest from "../../lib/faces/clocksdev/manifest.json";
import { PER_PAGE } from "../../lib/faces/clocksdev/paging.ts";

export function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  const pages = Math.ceil(manifest.length / PER_PAGE);
  return Array.from({ length: pages }, (_, i) => ({ params: { page: String(i + 1) } }));
}

interface Choice {
  include?: boolean;
  x10?: boolean;
}

// Read, not imported: an import is cached by the module graph and would go stale
// the moment the picker wrote to it. Astro re-runs this per request in dev, so
// the page always shows what is actually in the file — hand edits included.
const saved = JSON.parse(readFileSync("faces.json", "utf8")) as Record<string, Choice>;

const entries = manifest as { slug: string; name: string; author: string }[];
const pages = Math.ceil(entries.length / PER_PAGE);
const index = Number(Astro.params.page) - 1;
const names = entries.slice(index * PER_PAGE, (index + 1) * PER_PAGE).map((entry, i) => {
  const at = index * PER_PAGE + i;
  const name = `cd-${entry.slug}`;
  return {
    name,
    title: entry.name,
    author: entry.author,
    /** Its place in faces.json, 1-based, for editing by hand. */
    number: at + 1,
    include: saved[name]?.include !== false,
    x10: saved[name]?.x10 === true,
    // The hour hand is a track's place in the playlist; here it is the clock's
    // place in the forty, so no two on a page sit at the same hour.
    hours: (at / entries.length) * 12,
  };
});

// Built here rather than inline: a "/" inside an expression in <title> is enough
// to make prettier's Astro plugin close the head early and rearrange the page.
const title = `faces ${index + 1} of ${pages}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: dark;
        --line: #2a2a2a;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background: #0a0a0a;
        color: #e2e2e2;
        font:
          12px/1.4 ui-sans-serif,
          system-ui,
          sans-serif;
        padding: 3.25rem 1rem 2rem;
      }
      /* One row, always reachable: the point is flipping between pages while
         the clocks keep running. */
      .bar {
        position: fixed;
        inset: 0 0 auto;
        z-index: 2;
        display: flex;
        gap: 0.4rem;
        align-items: center;
        padding: 0.5rem 1rem;
        background: #0a0a0aee;
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(6px);
      }
      button,
      .bar a {
        font: inherit;
        color: inherit;
        background: none;
        border: 1px solid var(--line);
        border-radius: 4px;
        padding: 0.3rem 0.6rem;
        cursor: pointer;
        text-decoration: none;
      }
      button:hover,
      .bar a:hover {
        border-color: #666;
      }
      button[aria-pressed="true"] {
        background: #e2e2e2;
        color: #0a0a0a;
        border-color: #e2e2e2;
      }
      .bar a[aria-current="page"] {
        border-color: #666;
        background: #1c1c1c;
      }
      .spacer {
        flex: 1;
      }
      /* Whether the last write landed. Green on save, red if the dev server did
         not take it — the one thing worth knowing and not worth a sentence. */
      #saved {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #333;
        transition: background 150ms;
      }
      #saved[data-state="ok"] {
        background: #24cb71;
      }
      #saved[data-state="bad"] {
        background: #ff2f2f;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 1rem;
      }
      figure {
        border: 1px solid var(--line);
        border-radius: 6px;
        overflow: hidden;
      }
      /* Roughly the shape the site gives them, so a judgement here holds there. */
      .stage {
        position: relative;
        aspect-ratio: 16 / 10;
        background: #000;
        overflow: hidden;
      }
      .mirror {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        overflow: hidden;
      }
      .mirror-box {
        position: relative;
        overflow: hidden;
      }
      /* A component that throws still gets a tile, so the grid keeps its shape
         and the checkboxes under it still work. */
      .stage[data-broken]::after {
        content: "✕";
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        color: #ff2f2f;
      }
      figcaption {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        padding: 0.4rem 0.55rem;
        border-top: 1px solid var(--line);
      }
      .num {
        font-variant-numeric: tabular-nums;
        opacity: 0.4;
      }
      label {
        display: flex;
        align-items: center;
        cursor: pointer;
      }
      input {
        accent-color: #24cb71;
        width: 15px;
        height: 15px;
        cursor: pointer;
      }
      .who {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        opacity: 0.5;
      }
      figure:has(.inc:not(:checked)) .stage {
        opacity: 0.22;
      }
    </style>
  </head>

  <body>
    <nav class="bar">
      <button id="pause" type="button" aria-pressed="false" title="pause">❚❚</button>
      <button id="x10" type="button" aria-pressed="false" title="10× everything here">10×</button>
      <span id="saved" title="saved to faces.json"></span>
      <span class="spacer"></span>
      {
        Array.from({ length: pages }, (_, i) => (
          <a href={`/faces/${i + 1}`} aria-current={i === index ? "page" : undefined}>
            {i + 1}
          </a>
        ))
      }
      <span class="spacer"></span>
    </nav>

    <div class="grid">
      {
        names.map((face) => (
          <figure>
            <div class="stage" data-host={face.name} />
            <figcaption>
              <span class="num">{String(face.number).padStart(2, "0")}</span>
              <label title="include">
                <input class="inc" type="checkbox" data-name={face.name} checked={face.include} />
              </label>
              <label title="10×">
                <input class="ten" type="checkbox" data-name={face.name} checked={face.x10} />
              </label>
              <span class="who">
                {face.title} · {face.author || "—"}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <script id="page-faces" type="application/json" is:inline set:html={JSON.stringify(names)} />
    <script id="page-saved" type="application/json" is:inline set:html={JSON.stringify(saved)} />
    <script>
      import { MIRRORED } from "../../lib/faces/clocksdev/index.ts";

      interface Choice {
        include: boolean;
        x10: boolean;
      }

      const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const json = (id: string) => JSON.parse(el(id).textContent ?? "null");

      const faces = json("page-faces") as { name: string; hours: number }[];
      const choices = json("page-saved") as Record<string, Choice>;
      const saved = el("saved");

      // ── Controls first ──────────────────────────────────────────────────
      // Before a single clock is mounted, on purpose. These are forty
      // components this repo did not write, and when one of them threw on the
      // way up it took the rest of this script with it — leaving checkboxes
      // that still looked clickable and saved nothing. Nothing below can reach
      // this now.

      let writing: Promise<void> = Promise.resolve();
      function save() {
        // Queued rather than fired off in parallel: two quick clicks must not
        // race to write the same file.
        writing = writing.then(async () => {
          try {
            const response = await fetch("/__faces", {
              method: "POST",
              body: JSON.stringify(choices),
            });
            saved.dataset.state = response.ok ? "ok" : "bad";
          } catch {
            saved.dataset.state = "bad";
          }
        });
      }

      for (const input of document.querySelectorAll<HTMLInputElement>("input[data-name]")) {
        const name = input.dataset.name!;
        const key = input.classList.contains("inc") ? "include" : "x10";
        choices[name] ??= { include: true, x10: false };
        input.addEventListener("change", () => {
          choices[name] = { ...choices[name]!, [key]: input.checked };
          save();
        });
      }

      let paused = false;
      const pause = el<HTMLButtonElement>("pause");
      pause.addEventListener("click", () => {
        paused = !paused;
        pause.setAttribute("aria-pressed", String(paused));
      });

      // The page 10× ticks all ten boxes rather than holding a state of its own,
      // so there is nothing that can disagree with what is in the file.
      const ten = el<HTMLButtonElement>("x10");
      ten.addEventListener("click", () => {
        const on = ten.getAttribute("aria-pressed") !== "true";
        ten.setAttribute("aria-pressed", String(on));
        for (const input of document.querySelectorAll<HTMLInputElement>("input.ten")) {
          if (input.checked === on) continue;
          input.checked = on;
          input.dispatchEvent(new Event("change"));
        }
      });

      // ── Then the clocks ─────────────────────────────────────────────────

      const running = faces.flatMap((face) => {
        const mirror = MIRRORED.find((m) => m.name === face.name);
        const stage = document.querySelector<HTMLElement>(`[data-host="${face.name}"]`);
        if (!mirror || !stage) return [];
        try {
          const box = document.createElement("div");
          box.className = "mirror";
          stage.append(box);
          const handle = mirror.mount(box, { elapsed: 0, hours: face.hours });
          return [{ name: face.name, hours: face.hours, handle, t: 0 }];
        } catch (error) {
          // Worth seeing rather than hiding: a clock that cannot mount here
          // cannot mount on the site either, which is a reason to untick it.
          console.error(`${face.name} failed to mount`, error);
          stage.dataset.broken = "";
          return [];
        }
      });

      let last = performance.now();
      requestAnimationFrame(function frame(now) {
        const dt = (now - last) / 1000;
        last = now;
        for (const face of running) {
          // Each clock keeps its own elapsed time, so turning 10× on winds it
          // forward from here rather than jumping it.
          if (!paused) face.t += dt * (choices[face.name]?.x10 ? 10 : 1);
          try {
            face.handle.update({ elapsed: face.t, hours: face.hours });
          } catch {
            // A throw here would kill the loop and freeze every clock on the page.
          }
        }
        requestAnimationFrame(frame);
      });
    </script>
  </body>
</html>
