    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.123.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
